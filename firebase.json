{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      ".git/**",
      ".firebase/**",
      ".kilo/**",
      "netlify/**",
      "netlify.toml",
      "**/node_modules/**",
      "src",
      "public",
      "package.json",
      "package-lock.json",
      "README.md"
    ],
    "cleanUrls": true
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
